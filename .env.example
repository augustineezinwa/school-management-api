# ===========================================
# School Management API - Environment example
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ===========================================

# ----- Required -----
MONGO_URI=mongodb://localhost:27017/axion
LONG_TOKEN_SECRET=your-long-token-secret-min-32-chars
SHORT_TOKEN_SECRET=your-short-token-secret-min-32-chars
NACL_SECRET=your-nacl-secret-min-32-chars

# ----- Server -----
USER_PORT=5111
ENV=development
SERVICE_NAME=axion

# ----- Rate limiting (optional) -----
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# ----- Redis (optional; used for cache/cortex if needed) -----
# REDIS_URI=redis://127.0.0.1:6379

# ----- Test (optional; for integration tests) -----
# TEST_MONGO_URI=mongodb://localhost:27017/test
